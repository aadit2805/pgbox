{
  "name": "pgbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "define": { "import.meta.url": "\"file:///pglite/index.js\"" },
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.data", "**/*.bin"], "fallthrough": true }
  ],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "DB", "class_name": "PostgresDatabase" }] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Database"] },
    { "tag": "v2", "new_sqlite_classes": ["PostgresDatabase"] },
    { "tag": "v3", "deleted_classes": ["Database"] }
  ]
}
